    {id: "20261111005400214830", idx: 12, institution_id: "4520385", regions: ["44200"], props: {policy_name: "아산시 청년의 날 행사", policy_description: "법정기념일인 청년의 날(9월 셋째주 토요일)을 기념하여, 청년 문화 향유 기회 확대 및 청년 소통의 장 마련", application_period: "20260919 ~ 20260919", application_period_status: "present", application_start_date: "2026-09-19", application_end_date: "2026-09-19", application_method: "해당없음", min_age: 0, max_age: 0, age_limit_flag: "Y"}, benefit_id: "20261111005400214830:001", benefit: {benefit_index: 1, description: "기념식, 토크 콘서트, 뮤직 페스티벌, 부대 행사 등", delivery_method: "0042002"}},
    {id: "20261111005400114819", idx: 23, institution_id: null, regions: ["44825"], props: {policy_name: "지역특화 임대형 스마트팜", policy_description: "스마트팜에 도전하는 청년들이 적정한 임차료로 창농할 수 있도록 임대형 스마트팜 조성", application_period_status: "unknown", application_method: "27년 하반기 모집 예정", min_age: 18, max_age: 40, income_condition_note: "-", age_limit_flag: "Y"}, benefit_id: "20261111005400114819:001", benefit: {benefit_index: 1, description: "임대형 스마트팜 단지 ①부지 기반조성, ②온실, ③에너지시설(공기열) \n\n❍ 스마트팜 시설 임대 : 정부와 지자체가 조성한 온실 및 재배시설을 청년농업인이 임대해 활용 가능\n\n❍ 영농 기반 제공 : 스마트팜 온실, 부지 기반시설, 에너지 공급시설 등 재배에 필요한 기반을 갖춘 시설을 이용 가능\n\n❍ 초기 투자 부담 완화 : 본인이 직접 온실을 신축하는 데 드는 큰 초기 시설 투자비를 줄이고, 재배와 농장 운영 경험을 쌓기 가능", delivery_method: "0042001"}},
    {id: "20261111005400214817", idx: 25, institution_id: "4520385", regions: ["44200"], props: {policy_name: "청년내일카드 사업", policy_description: "관내 중소·중견기업에 신규 입사한 아산시 거주 청년(만 18~39세) 및 쉼표(고립·은둔) 청년에게 6개월간 월 25만원(총 150만원)을 지원(입사 7~12개월차 지원)", application_period: "20260101 ~ 20261231", application_period_status: "present", application_start_date: "2026-01-01", application_end_date: "2026-12-31", application_method: "온라인", min_age: 18, max_age: 39, income_condition_note: "(기업재직청년) 기준 중위소득 150%이하인 자로 월 평균 보수액이 3,846,357원 이하 근로자", application_url: "https://www.asan.go.kr/naeil/", age_limit_flag: "Y"}, benefit_id: "20261111005400214817:001", benefit: {benefit_index: 1, description: "1인당 150만원(6개월 간 매월 최대 25만원 지원)\n(기업재직청년) 근속 7개월~12개월\n(고립은둔청년) 쉼표청년지원사업 6개월(사업참여율 80%이상)", delivery_method: "0042006"}},
    {id: "20261109005400214804", idx: 33, institution_id: "6130000", regions: ["12800"], props: {policy_name: "영암군 청년 자격증 응시료 지원사업 11월 모집", policy_description: "청년의 응시료 부담을 완화하기 위해 연 최대 10만원까지 어학, 한국사, 국가공인자격증 응시료 실비 지원", application_period: "20261101 ~ 20261115", application_period_status: "present", application_start_date: "2026-11-01", application_end_date: "2026-11-15", application_method: "방문∙이메일 신청 → 서류심사 → 대상자 선정 및 통보 → 지원금 지급", min_age: 19, max_age: 50, age_limit_flag: "Y"}, benefit_id: "20261109005400214804:001", benefit: {benefit_index: 1, description: "2026.01.01. 이후 시행된 어학, 한국사, 국가공인자격증 시험 응시료 연간 최대 10만원 실비 지원", delivery_method: "0042005"}},
    {id: "20261021005400214249", idx: 491, institution_id: null, regions: ["12110", "12130", "12150", "12170", "12190", "12710", "12720", "12730", "12740", "12750", "12760", "12770", "12780", "12790", "12800", "12810", "12820", "12830", "12840", "12850", "12860", "12870"], props: {policy_name: "청년 해외취업 지원", policy_description: "해외 취업 기회제공으로 청년 고용과 국제적 역량을 갖춘 글로벌 인재양성을 지원합니다.", application_period: "~", application_period_status: "present", application_method: "1. 모집공고 확인\n2. 참여신청\n3. 서류심사\n4. 면접심사\n5. 최종선정\n6. 프로그램 참여", min_age: 19, max_age: 34, age_limit_flag: "N"}, benefit_id: "20261021005400214249:001", benefit: {benefit_index: 1, description: "미국 등 채용형 인턴 해외취업 프로그램 지원\n - 해외 인턴취업을 위한 외국어 교육, 비자발급, 항공료, 보험, 기업매칭 등 지원", delivery_method: "0042002"}},
    {id: "20261021005400214166", idx: 571, institution_id: "6114555", regions: ["11110", "11140", "11170", "11200", "11215", "11230", "11260", "11290", "11305", "11320", "11350", "11380", "11410", "11440", "11470", "11500", "11530", "11545", "11560", "11590", "11620", "11650", "11680", "11710", "11740"], props: {policy_name: "2026 서울형 강소기업 육성 지원", policy_description: "청년 일자리창출 확대 및 일생활균형 조직문화, 복지혜택이 우수한 서울시 소재 중소기업 발굴", application_period_status: "unknown", application_method: "모집공고→정량심사→면접심사→최종선정", min_age: 18, max_age: 39, income_condition_note: "정규직 채용 후 12개월 만근", application_url: "https://youth.seoul.go.kr/content.do?key=2310100029", age_limit_flag: "Y"}, benefit_id: "20261021005400214166:001", benefit: {benefit_index: 1, description: "청년 정규직 채용 및 12개월 만근 시 근무환경개선금 지급(기업당 3명, 최대 4,500만원)", delivery_method: "0042006"}},
    {id: "20261006005400213910", idx: 816, institution_id: null, regions: ["51130"], props: {policy_name: "청년 우울증 치료비 지원 추가 모집 공고", policy_description: "취업 스트레스, 사회적 고립 등으로 마음의 병을 앓고 있는 청년들에게 치유의 기회 제공", application_period: "20261006 ~ 20261023", application_period_status: "present", application_start_date: "2026-10-06", application_end_date: "2026-10-23", application_method: "○ 접수기간: 2026. 10. 6.(화) 09:00 ~ 2026. 10. 23.(금) 18:00\n○ 접수방법\n -원주시 청년지원센터 홈페이지 내 프로그램 신청의 네이버폼 제출 ※ 10. 23.(금) 18:00 까지 접수 가능\n※ 제출서류의 허위기재, 기재사항 착오 및 누락, 연락 불능 등으로 인한 불이익은 지원자의 책임으로 함", min_age: 18, max_age: 39, application_url: "https://www.wonju.go.kr/wjyouth/viewTnWjyouthProgrmU.do?progrmNo=71&key=5942", age_limit_flag: "N"}, benefit_id: "20261006005400213910:001", benefit: {benefit_index: 1, description: "-관내 정신건강의학과 전문의에 의한 치료비, 약제비에 소요되는 외래 본인일부부담금(외래비)\n-1인 1년 최대 400,000원 / 실비지원, 최대 2년차까지 지원", delivery_method: "0042013"}},
    {id: "20260504005400213069", idx: 1578, institution_id: "4620136", regions: ["44825"], props: {policy_name: "태안 청년네트워크 운영", policy_description: "청년 문제 해결을 위한 의제와 정책을 발굴하고 실현하기 위해 청년 참여를 기반으로 한 청년 네트워크 운영", application_period: "20251201 ~ 20271231", application_period_status: "present", application_start_date: "2025-12-01", application_end_date: "2027-12-31", application_method: "태안군 홈페이지 공고(공개모집)", min_age: 18, max_age: 45, age_limit_flag: "Y"}, benefit_id: "20260504005400213069:001", benefit: {benefit_index: 1, description: "청년네트워크 참석 실비 및 급·간식 제공", delivery_method: "0042001"}},
    {id: "20260429005400212931", idx: 1712, institution_id: "6130000", regions: ["12270"], props: {policy_name: "[남구] 월간 청년밋업 강연(1월)", policy_description: "청년들을 위한 재테크 강연\r\n○ 일시/장소: 2026. 1. 28.(수) 14:00~17:00 / 남구청 8층 대회의실\r\n○ 추진내용: 청년 눈높이에 맞는 현실 기반 금융·경제 교육프로그램 실시\r\n○ 대    상: 남구 청년네트워크 및 지역 청년 50여 명\r\n○ 강    사\r\n 1) 곽지현 (‘생활의 달인’, ‘유퀴즈’ 등 프로그램 다수 출연)\r\n  - 강의주제: 절약과 저축으로 시작하는 재테크 첫걸음\r\n 2) 김잔잔 (구독자 17.5만명 금융분야 유튜브 크리에이터)\r\n  - 강의주제: 원숭이도 따라하는 재테크", application_period_status: "unknown", application_method: "https://naver.me/xydMbCD8", min_age: 0, application_url: "https://naver.me/xydMbCD8", age_limit_flag: "Y"}, benefit_id: "20260429005400212931:001", benefit: {benefit_index: 1, description: "❍ (일    시) 2026. 1. 28.(수) 14:00 ~ 17:00\r\n❍ (장    소) 남구청 8층 대회의실\r\n❍ (대    상) 남구 청년네트워크 및 지역 청년 50여 명\r\n❍ (내    용) 청년 맞춤형 금융·재테크·저축 관리 교육 실시(제1회)\r\n❍ (추진방법) 강연·행사 전문업체 용역을 통한 강사 섭외 및 행사운영\r\n❍ (강 연 자)\r\n 1) 곽지현 강사 (‘생활의 달인’, ‘유퀴즈’ 등 프로그램 다수 출연)\r\n   - 강의내용: 절약과 저축으로 시작하는 재테크 첫걸음(짠테크 꿀팁 5가지)\r\n 2) 김잔잔 대표 (마음편한재테크 대표, 구독자 17.5만명 재테크 유튜버)\r\n   - 강의내용: 원숭이도 따라하는 재테크(예금부터 주식까지 딱 ‘이것만’하세요)", delivery_method: "0042005"}},
    {id: "20251111005400211842", idx: 2695, institution_id: "4620136", regions: ["44825"], props: {policy_name: "태안 청년 창업 지원", policy_description: "청년의 일자리와 설자리 제공으로 지역 청년의 정착과 외부 청년의 유입을 통한 지역활력 도모", application_period: "20250101 ~ 20251231", application_period_status: "present", application_start_date: "2025-01-01", application_end_date: "2025-12-31", min_age: 18, max_age: 45, age_limit_flag: "N"}, benefit_id: "20251111005400211842:001", benefit: {benefit_index: 1, description: "입주기업 사업화 지원, 창업상담 및 교육 등", delivery_method: "0042006"}}
  ] AS row
  MERGE (q:YouthPolicy {policy_id: row.id})
  SET q += row.props,
      q.application_start_date = date(row.props.application_start_date),
      q.application_end_date = date(row.props.application_end_date)
  WITH row, q
  OPTIONAL MATCH (i:Institution {institution_id: row.institution_id})
  FOREACH (_ IN CASE WHEN i IS NULL THEN [] ELSE [1] END |
    MERGE (q)-[:OPERATED_BY]->(i)
  )
  FOREACH (code IN row.regions |
    MERGE (r:Region {region_code: code})
    MERGE (q)-[:APPLIES_TO]->(r)
  )
  MERGE (b:Benefit {benefit_id: row.benefit_id})
  SET b += row.benefit
  MERGE (q)-[:HAS_BENEFIT]->(b)
  FOREACH (field IN [k IN ["application_period", "application_start_date", "application_end_date", "application_method", "min_age", "max_age", "income_condition_note", "application_url"] WHERE row.props[k] IS NOT NULL] |
    MERGE (e:Evidence {evidence_id: 'youth_policy|' + row.id + '|' + field + '|processed'})
    SET e.source_name = '청년정책 API',
        e.source_dataset = 'youth_policy',
        e.source_file = 'data/processed/youth_policy.json',
        e.source_record_key = row.id,
        e.source_field = field,
        e.supports_property = field,
        e.source_value = row.props[field],
        e.source_locator = '/records/' + toString(row.idx) + '/' + field
    MERGE (q)-[:SUPPORTED_BY]->(e)
  )
  FOREACH (field IN [k IN ['description', 'delivery_method'] WHERE row.benefit[k] IS NOT NULL] |
    MERGE (e:Evidence {evidence_id: 'youth_policy|' + row.id + '|' + field + '|processed'})
    SET e.source_name = '청년정책 API',
        e.source_dataset = 'youth_policy',
        e.source_file = 'data/processed/youth_policy.json',
        e.source_record_key = row.id,
        e.source_field = CASE field WHEN 'description' THEN 'support_content' ELSE 'policy_provision_method_code' END,
        e.supports_property = field,
        e.source_value = row.benefit[field],
        e.source_locator = '/records/' + toString(row.idx) + '/' +
          CASE field WHEN 'description' THEN 'support_content' ELSE 'policy_provision_method_code' END
    MERGE (b)-[:SUPPORTED_BY]->(e)
  )
  RETURN count(*) AS youth_policies
}
RETURN financial_products + youth_policies AS sample_records,
       financial_products, youth_policies, rate_options, institutions;
