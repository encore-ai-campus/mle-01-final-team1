    {id: "fss:rent:020000:202610:0010002:SC002013SC002003", idx: 2, dataset: "loan", institution_id: "0010002", disclosure_id: "fss:rent:020000:202610:0010002:SC002013SC002003:202610", product_type_name: "전세자금대출", props: {product_name: "전세담보대출", product_code: "SC002013SC002003", join_method: ["영업점", "스마트폰"]}, join_method_json: "[\"영업점\",\"스마트폰\"]", disclosure: {product_id: "fss:rent:020000:202610:0010002:SC002013SC002003", disclosure_month: "202610", disclosure_start_date: "2026-10-19", disclosure_end_date_status: "not_provided"}, rates: [{rate_id: "fss:rent:020000:202610:0010002:SC002013SC002003:202610:C:S", idx: 8, props: {rate_type_code: "C", rate_type: "변동금리", repayment_type_code: "S", repayment_type: "만기일시상환방식", min_rate: 4.94, max_rate: 5.34, average_rate: 5.15, average_rate_status: "present", min_rate_basis: "advertised_range", average_rate_basis: "average_new_loans", max_rate_basis: "advertised_range"}}]},
    {id: "fss:rent:020000:202610:0010016:20460801000001001", idx: 3, dataset: "loan", institution_id: "0010016", disclosure_id: "fss:rent:020000:202610:0010016:20460801000001001:202610", product_type_name: "전세자금대출", props: {product_name: "DGB 전세자금대출", product_code: "20460801000001001", join_method: ["영업점", "모집인"]}, join_method_json: "[\"영업점\",\"모집인\"]", disclosure: {product_id: "fss:rent:020000:202610:0010016:20460801000001001", disclosure_month: "202610", disclosure_start_date: "2026-10-20", disclosure_end_date: "2026-11-30", disclosure_end_date_status: "present"}, rates: [{rate_id: "fss:rent:020000:202610:0010016:20460801000001001:202610:C:S", idx: 9, props: {rate_type_code: "C", rate_type: "변동금리", repayment_type_code: "S", repayment_type: "만기일시상환방식", min_rate: 5.82, max_rate: 5.82, average_rate: 4.87, average_rate_status: "present", min_rate_basis: "advertised_range", average_rate_basis: "average_new_loans", max_rate_basis: "advertised_range"}}]},
    {id: "fss:rent:020000:202610:0010017:1029", idx: 7, dataset: "loan", institution_id: "0010017", disclosure_id: "fss:rent:020000:202610:0010017:1029:202610", product_type_name: "전세자금대출", props: {product_name: "BNK전세안심대출", product_code: "1029", join_method: ["영업점", "모집인"]}, join_method_json: "[\"영업점\",\"모집인\"]", disclosure: {product_id: "fss:rent:020000:202610:0010017:1029", disclosure_month: "202610", disclosure_start_date: "2026-10-06", disclosure_end_date_status: "not_provided"}, rates: [{rate_id: "fss:rent:020000:202610:0010017:1029:202610:C:D", idx: 13, props: {rate_type_code: "C", rate_type: "변동금리", repayment_type_code: "D", repayment_type: "분할상환방식", min_rate: 4.39, max_rate: 5.19, average_rate_status: "not_provided", min_rate_basis: "advertised_range", average_rate_basis: "average_new_loans", max_rate_basis: "advertised_range"}}, {rate_id: "fss:rent:020000:202610:0010017:1029:202610:F:D", idx: 14, props: {rate_type_code: "F", rate_type: "고정금리", repayment_type_code: "D", repayment_type: "분할상환방식", min_rate: 5.51, max_rate: 6.31, average_rate_status: "not_provided", min_rate_basis: "advertised_range", average_rate_basis: "average_new_loans", max_rate_basis: "advertised_range"}}, {rate_id: "fss:rent:020000:202610:0010017:1029:202610:C:S", idx: 15, props: {rate_type_code: "C", rate_type: "변동금리", repayment_type_code: "S", repayment_type: "만기일시상환방식", min_rate: 4.39, max_rate: 5.19, average_rate: 4.4, average_rate_status: "present", min_rate_basis: "advertised_range", average_rate_basis: "average_new_loans", max_rate_basis: "advertised_range"}}, {rate_id: "fss:rent:020000:202610:0010017:1029:202610:F:S", idx: 16, props: {rate_type_code: "F", rate_type: "고정금리", repayment_type_code: "S", repayment_type: "만기일시상환방식", min_rate: 5.51, max_rate: 6.31, average_rate: 5.84, average_rate_status: "present", min_rate_basis: "advertised_range", average_rate_basis: "average_new_loans", max_rate_basis: "advertised_range"}}]},
    {id: "fss:rent:050000:202610:0010594:ABLKeymoney1", idx: 50, dataset: "loan", institution_id: "0010594", disclosure_id: "fss:rent:050000:202610:0010594:ABLKeymoney1:202610", product_type_name: "전세자금대출", props: {product_name: "ABL전세자금대출", product_code: "ABLKeymoney1", join_method: ["영업점", "모집인"]}, join_method_json: "[\"영업점\",\"모집인\"]", disclosure: {product_id: "fss:rent:050000:202610:0010594:ABLKeymoney1", disclosure_month: "202610", disclosure_start_date: "2026-10-16", disclosure_end_date_status: "not_provided"}, rates: [{rate_id: "fss:rent:050000:202610:0010594:ABLKeymoney1:202610:F:S", idx: 96, props: {rate_type_code: "F", rate_type: "고정금리", repayment_type_code: "S", repayment_type: "만기일시상환방식", min_rate: 5.1, max_rate: 5.2, average_rate: 4.74, average_rate_status: "present", min_rate_basis: "advertised_range", average_rate_basis: "average_new_loans", max_rate_basis: "advertised_range"}}]}
  ] AS row
  MATCH (i:Institution {institution_id: row.institution_id})
  MERGE (p:FinancialProduct {product_id: row.id})
  SET p += row.props
  MERGE (t:ProductType {product_type_code: row.dataset})
  SET t.product_type_name = row.product_type_name
  MERGE (d:ProductDisclosure {disclosure_id: row.disclosure_id})
  SET d += row.disclosure,
      d.disclosure_start_date = date(row.disclosure.disclosure_start_date),
      d.disclosure_end_date = date(row.disclosure.disclosure_end_date)
  MERGE (p)-[:OFFERED_BY]->(i)
  MERGE (p)-[:HAS_PRODUCT_TYPE]->(t)
  MERGE (p)-[:HAS_DISCLOSURE]->(d)
  WITH row, p, d,
       CASE row.dataset
         WHEN 'deposit' THEN 'FSS FinLife depositProductsSearch'
         WHEN 'savings' THEN 'FSS FinLife savingProductsSearch'
         ELSE 'FSS FinLife rentHouseLoanProductsSearch'
       END AS origin_name
  FOREACH (field IN [k IN ["join_method", "special_condition", "min_subscription_amount_krw", "additional_note", "eligible_member"] WHERE row.props[k] IS NOT NULL] |
    MERGE (e:Evidence {evidence_id: row.dataset + '|' + row.id + '|' + field + '|processed'})
    SET e.source_name = origin_name,
        e.source_dataset = row.dataset,
        e.source_file = 'data/processed/' + row.dataset + '_products.json',
        e.source_record_key = row.id,
        e.source_field = field,
        e.supports_property = field,
        e.source_value = CASE field WHEN 'join_method' THEN row.join_method_json ELSE row.props[field] END,
        e.source_locator = '/records/' + toString(row.idx) + '/' + field
    MERGE (p)-[:SUPPORTED_BY]->(e)
  )
  WITH row, d, origin_name
  CALL (row, d, origin_name) {
    UNWIND row.rates AS option
    MERGE (r:RateOption {rate_option_id: option.rate_id})
    SET r += option.props,
        r.base_rate = toFloat(option.props.base_rate),
        r.min_rate = toFloat(option.props.min_rate),
        r.max_rate = toFloat(option.props.max_rate),
        r.average_rate = toFloat(option.props.average_rate)
    MERGE (d)-[:HAS_RATE_OPTION]->(r)
    FOREACH (field IN [k IN ["base_rate", "min_rate", "max_rate", "average_rate"] WHERE option.props[k] IS NOT NULL] |
      MERGE (e:Evidence {evidence_id: row.dataset + '|' + option.rate_id + '|' + field + '|processed'})
      SET e.source_name = origin_name,
          e.source_dataset = row.dataset,
          e.source_file = 'data/processed/' + row.dataset + '_rates.json',
          e.source_record_key = option.rate_id,
          e.source_field = field,
          e.supports_property = field,
          e.source_value = option.props[field],
          e.source_locator = '/records/' + toString(option.idx) + '/' + field
      MERGE (r)-[:SUPPORTED_BY]->(e)
    )
    RETURN count(*) AS linked_rates
  }
  RETURN count(*) AS financial_products, sum(linked_rates) AS rate_options
}
CALL () {
  UNWIND [
    {id: "20261113005400214853", idx: 0, institution_id: "6130000", regions: ["12110", "12130", "12150", "12170", "12190", "12710", "12720", "12730", "12740", "12750", "12760", "12770", "12780", "12790", "12800", "12810", "12820", "12830", "12840", "12850", "12860", "12870"], props: {policy_name: "2026년 전남청년미래센터 가족돌봄청(소)년 자기돌봄비 지원", policy_description: "가족돌봄으로 인해 미래 준비에 어려움을 겪는 가족돌봄청(소)년에게 경제적 지원을 제공하여 자기계발 및 성장 기회를 제공하고자 합니다.", application_period_status: "unknown", application_method: "온라인 신청> 참여요건 확인> 대상자 선정 안내 >\n자기돌봄계획서 작성 > 지원금 지급", min_age: 13, max_age: 35, age_limit_flag: "Y"}, benefit_id: "20261113005400214853:001", benefit: {benefit_index: 1, description: "1회 200만원 우리카드 선포인트 지급\n지급일로부터 1년간 사용가능", delivery_method: "0042005"}},
