# 백엔드 환경변수 예시. 실제 API 키는 .env에만 입력한다.
APP_ENV=development
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Neo4j and LLM configuration (not used by the current API scaffold).
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
OPENAI_API_KEY=

# Langfuse Cloud: optional top-level LangGraph tracing.
# False by default. Never commit real keys to Git.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
